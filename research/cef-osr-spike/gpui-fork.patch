diff --git a/crates/gpui_apple/src/surface_lifetime.rs b/crates/gpui_apple/src/surface_lifetime.rs
new file mode 100644
index 0000000000..acc1d79f84
--- /dev/null
+++ b/crates/gpui_apple/src/surface_lifetime.rs
@@ -0,0 +1,16 @@
+//! Keep both CoreVideo textures and their source alive until Metal finishes.
+use core_video::{metal_texture::CVMetalTexture, pixel_buffer::CVPixelBuffer};
+use std::cell::Cell;
+pub(crate) fn hold_until_completed(
+    command: &metal::CommandBufferRef,
+    frame: CVPixelBuffer,
+    primary: CVMetalTexture,
+    secondary: CVMetalTexture,
+) {
+    let resources = Cell::new(Some((frame, primary, secondary)));
+    let completed = block::ConcreteBlock::new(move |_: &metal::CommandBufferRef| {
+        drop(resources.take());
+    })
+    .copy();
+    command.add_completed_handler(&completed);
+}
diff --git a/crates/gpui_apple/src/surface_observer.rs b/crates/gpui_apple/src/surface_observer.rs
new file mode 100644
index 0000000000..5f893d88d8
--- /dev/null
+++ b/crates/gpui_apple/src/surface_observer.rs
@@ -0,0 +1,11 @@
+//! Optional surface presentation telemetry for embedding diagnostics.
+use std::sync::{Arc, OnceLock};
+pub type Observer = Arc<dyn Fn(&[usize], f64) + Send + Sync>;
+static OBSERVER: OnceLock<Observer> = OnceLock::new();
+/// Install before creating windows. Called on Metal's presentation callback thread.
+pub fn install(observer: Observer) -> bool {
+    OBSERVER.set(observer).is_ok()
+}
+pub(crate) fn observer() -> Option<Observer> {
+    OBSERVER.get().cloned()
+}
