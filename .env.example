# butler environment variables
# Copy this file to $BUTLER_DATA/.env and fill in your values.
# install.sh will create $BUTLER_DATA/.env for you interactively.

# Optional: Codex subscription login profile.
# install.sh opens Butler's browser OAuth flow. The default redirect URI is:
# http://localhost:1455/auth/callback
# The saved profile lives under $BUTLER_DATA/auth/openai-codex.json by default.
# BUTLER_CODEX_AUTH_PROFILE=~/.butler/auth/openai-codex.json
# Advanced OAuth overrides for development/testing only.
# BUTLER_CODEX_OAUTH_CLIENT_ID=custom_client_id
# BUTLER_CODEX_OAUTH_PORT=1455
# BUTLER_CODEX_OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
# BUTLER_CODEX_OAUTH_ORIGINATOR=butler

# Alternative: standard OpenAI API key auth.
# OPENAI_API_KEY=sk-...

# Optional web search providers.
# Default: duckduckgo-html, which needs no API key. Key-based providers fall
# back to DuckDuckGo HTML if auth fails during a tool call.
# BUTLER_WEB_SEARCH_PROVIDER=duckduckgo-html
# BUTLER_BRAVE_SEARCH_API_KEY=...
# BUTLER_TAVILY_API_KEY=...

# ── Optional ─────────────────────────────────────────────────────────────────

# Override default install paths (defaults shown)
# BUTLER_HOME=~/butler
# BUTLER_DATA=~/.butler

# Advanced: override Butler's managed Bun runtime.
# By default install.sh prepares $BUTLER_DATA/runtime/bun/current/bin/bun.
# BUTLER_BUN=/absolute/path/to/bun

# Disable new operational metrics writes without deleting historical metrics.
# BUTLER_METRICS_ENABLED=false

# Colon-separated list of additional skill directories
# BUTLER_SKILL_DIRS=~/my-skills:~/more-skills

# Worker task timeout in seconds (default: 600)
# WORKER_TIMEOUT=600

# Override runtime without editing butler.config.json
# Native runtime selection.
# BUTLER_RUNTIME=codex-api

# Override the OpenAI model used when BUTLER_RUNTIME=codex-api
# Dynamic default: discover the latest available Codex-family model via /v1/models.
# BUTLER_OPENAI_MODEL=auto:codex-latest

# Optional hosted provider base URL overrides.
# BUTLER_ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# BUTLER_ZAI_API_BASE_URL=https://api.z.ai/api/paas/v4

# Optional routing hint for OpenAI prompt caching.
# Useful when many requests share long, stable prefixes.
# Leave unset for maximum compatibility with OpenAI-compatible non-OpenAI servers.
# BUTLER_OPENAI_PROMPT_CACHE_KEY_PREFIX=butler

# Optional OpenAI prompt cache retention policy: in_memory or 24h
# 24h can improve hit rates for sparse workloads, but changes provider-side retention semantics.
# Leave unset to use the provider default.
# BUTLER_OPENAI_PROMPT_CACHE_RETENTION=in_memory
