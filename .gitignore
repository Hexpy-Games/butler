# ── Private user data accidentally created inside the checkout ───────────────
data/
.project-ledger/
.dev-butler/

# Project-management drafts belong in the external Project Ledger.
/docs/
/reports/
/.codex-ledger-drafts/

# ── Private top-level runtime paths must live under $BUTLER_DATA instead ─────
.env
/tasks/
/logs/
/config/
memory/hot/cache.md
memory/hot/*.md
memory/core.md
memory/user-profile.md
memory/projects/*.md
memory/conversations/
memory/db/
# ── Topic session dirs — per-thread CWD for unattached topics ────────────────
data/topics/

# ── Test secrets ─────────────────────────────────────────────────────────────
tests/.env.test

# ── Build artifacts ───────────────────────────────────────────────────────────
/target/
__pycache__/
node_modules
dist/
dist-ds-site*/
app-client/ui/.*/skills/
app-client/ui/.*/**/skills/
app-client/ui/skills/
.DS_Store
*.lockb
*.lance/

# ── Test debug/capture artifacts ──────────────────────────────────────────────
tests/recordings/
tests/debug_*
tests/capture_*
.tmp/
packages/butler-npm/THIRD_PARTY_NOTICES.txt*

# ── Backup files ──────────────────────────────────────────────────────────────
*.bak
data/personas/active.md

# ── E2E fixtures are synthetic data dirs; the unanchored `data/` above must not
#    drop them. Re-include only the directories: everything inside them is still
#    subject to the rules above, so .DS_Store, .env, *.bak, node_modules/ etc.
#    under fixtures stay ignored. (`memory/hot/*.md` and the other slash-containing
#    patterns are anchored to the repo root and never match fixture paths.)
!packages/butler-agent/rust/crates/butler-e2e/fixtures/**/data/
