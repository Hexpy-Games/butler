{
  "name": "butler",
  "version": "0.0.19",
  "type": "module",
  "private": true,
  "bin": {
    "butler": "./bin/butler.js"
  },
  "workspaces": [
    "packages/butler-app/client/electron",
    "packages/butler-app/client/ui",
    "packages/butler-progress-projection",
    "packages/project-ledger",
    "packages/butler-agent/src/interfaces/mcp-server",
    "packages/butler-agent/src/integrations/telegram"
  ],
  "scripts": {
    "setup": "${BUTLER_BUN:-bun} run packages/butler-agent/scripts/setup.ts",
    "lint": "eslint . && ${BUTLER_BUN:-bun} run --silent lint:design && ${BUTLER_BUN:-bun} run --silent lint:css",
    "lint:design": "${BUTLER_BUN:-bun} run --silent packages/butler-app/scripts/lint/design-token-lint.ts && ${BUTLER_BUN:-bun} run --silent packages/butler-app/scripts/lint/app-client-copy-lint.ts && ${BUTLER_BUN:-bun} run --silent packages/butler-app/scripts/lint/component-line-count-lint.ts && ${BUTLER_BUN:-bun} run --silent packages/butler-app/scripts/lint/css-module-global-lint.ts && ${BUTLER_BUN:-bun} run --silent packages/butler-app/scripts/lint/prop-boundary-lint.ts",
    "lint:css": "${BUTLER_BUN:-bun} run --silent format:css:check && stylelint \"packages/butler-app/client/ui/src/**/*.css\"",
    "lint:fix": "eslint . --fix",
    "format": "${BUTLER_BUN:-bun} run lint:fix && ${BUTLER_BUN:-bun} run format:css",
    "format:css": "prettier --write \"packages/butler-app/client/ui/src/**/*.css\"",
    "format:css:check": "prettier --check \"packages/butler-app/client/ui/src/**/*.css\" --log-level warn",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix packages/butler-app/client/ui run --silent typecheck",
    "test:unit": "${BUTLER_BUN:-bun} run --silent tools/validation/validate.ts test:unit:run",
    "test:unit:run": "${BUTLER_BUN:-bun} test tests/unit/*.test.ts",
    "test:unit:fast": "${BUTLER_BUN:-bun} run --silent tools/validation/validate.ts test:unit:fast:run",
    "test:unit:fast:run": "bash tests/unit/run-fast-unit-tests.sh",
    "test:unit:packaging": "${BUTLER_BUN:-bun} run --silent tools/validation/validate.ts test:unit:packaging:run --timeout=900",
    "test:unit:packaging:run": "${BUTLER_BUN:-bun} test tests/unit/app-first-run-smoke-script.test.ts tests/unit/app-managed-runtime.test.ts tests/unit/install-service-registration.test.ts tests/unit/install-upgrade.test.ts tests/unit/release-packaging.test.ts tests/unit/release-workflow.test.ts",
    "lint:btcc-shape": "${BUTLER_BUN:-bun} run --silent tools/btcc/lint-btcc-shape.ts",
    "test:btcc:integration": "${BUTLER_BUN:-bun} test tests/integration/btcc/*.test.ts",
    "cognition:memory:import-legacy": "${BUTLER_BUN:-bun} run packages/butler-agent/src/agent/cognition/memory/scripts/import-legacy-memory.ts",
    "conversation:historical-recovery": "${BUTLER_BUN:-bun} run packages/butler-agent/src/agent/conversation/historical-recovery-cli.ts",
    "cognition:memory:query-index": "${BUTLER_BUN:-bun} run packages/butler-agent/src/agent/cognition/memory/scripts/build-query-index.ts",
    "app:server": "${BUTLER_BUN:-bun} run packages/butler-agent/src/gateways/app/interface/cli/app-gateway-cli.ts",
    "app:web": "npm --prefix packages/butler-app/client/ui run build && ${BUTLER_BUN:-bun} run app:server",
    "app:ui:install": "npm --prefix packages/butler-app/client/ui install",
    "app:ui:build": "npm --prefix packages/butler-app/client/ui run build",
    "app:client:install": "npm --prefix packages/butler-app/client/electron install && npm --prefix packages/butler-app/client/ui install",
    "app:client": "npm --prefix packages/butler-app/client/ui run build && npm --prefix packages/butler-app/client/electron run start",
    "app:client:dev": "${BUTLER_BUN:-bun} run packages/butler-app/scripts/app-client-dev.ts",
    "app:first-run:test-env": "npm --prefix packages/butler-app/client/ui run build && exec ${BUTLER_BUN:-bun} run packages/butler-app/scripts/app-first-run-test-env.ts",
    "app:first-run:service-test-env": "npm --prefix packages/butler-app/client/ui run build && exec ${BUTLER_BUN:-bun} run packages/butler-app/scripts/app-first-run-test-env.ts --native-service",
    "app:install:test-env": "npm --prefix packages/butler-app/client/ui run build && exec ${BUTLER_BUN:-bun} run packages/butler-app/scripts/app-install-test-env.ts",
    "app:first-run:smoke": "npm --prefix packages/butler-app/client/ui run build && ${BUTLER_BUN:-bun} run tests/smoke/app-first-run-setup-smoke.ts",
    "app:client:managed-server:smoke": "npm --prefix packages/butler-app/client/ui run build && ${BUTLER_BUN:-bun} run packages/butler-app/scripts/app-client-managed-server-smoke.ts",
    "app:client:model-management:e2e": "npm --prefix packages/butler-app/client/ui run build && ${BUTLER_BUN:-bun} run tests/e2e/app-model-management-e2e.ts",
    "app:client:performance:report": "${BUTLER_BUN:-bun} run tests/support/packaged-performance-report.ts",
    "e2e:evidence-gate": "${BUTLER_BUN:-bun} run tests/e2e/butler-e2e-evidence-gate.ts",
    "e2e:gncc-cognition:live-llm": "BUTLER_GNCC_COGNITION_E2E_MODEL=openai/gpt-5.5 BUTLER_GNCC_COGNITION_E2E_REASONING=low ${BUTLER_BUN:-bun} run tests/e2e/gateway-neutral-cognition-sources-live-e2e.ts",
    "e2e:gncc-recovery:live-llm": "BUTLER_GNCC_RECOVERY_E2E_MODEL=openai/gpt-5.5 BUTLER_GNCC_RECOVERY_E2E_REASONING=low ${BUTLER_BUN:-bun} run tests/e2e/gateway-neutral-historical-recovery-live-e2e.ts",
    "e2e:memory-quality-ab": "${BUTLER_BUN:-bun} run tests/e2e/butler-memory-quality-ab.ts",
    "live:decision-context:medium": "${BUTLER_BUN:-bun} run tests/live/decision-context-medium-task.ts",
    "live:direct-work:semantic-progress": "${BUTLER_BUN:-bun} run tests/live/direct-work-semantic-progress.ts",
    "app:package:smoke": "npm --prefix packages/butler-app/client/ui run build && ${BUTLER_BUN:-bun} run tests/smoke/app-package-smoke.ts",
    "app:layout:smoke": "npm --prefix packages/butler-app/client/ui run build && ${BUTLER_BUN:-bun} run tests/smoke/app-layout-smoke.ts",
    "app:design-system:smoke": "npm --prefix packages/butler-app/client/ui run build && ${BUTLER_BUN:-bun} run tests/smoke/app-design-system-smoke.ts",
    "render": "npm --prefix packages/butler-app/client/ui run build && ${BUTLER_BUN:-bun} run tests/smoke/ds-viewer-render.ts",
    "app:ui:hmr:smoke": "${BUTLER_BUN:-bun} run packages/butler-app/scripts/app-ui-hmr-smoke.ts",
    "maintenance:context": "${BUTLER_BUN:-bun} run packages/butler-agent/scripts/prune-context-maintenance.ts",
    "install:docker": "bash tools/install-in-docker.sh",
    "install:docker:readme": "bash tools/readme-install-docker.sh",
    "release:agent:gate": "${BUTLER_BUN:-bun} run --silent deploy/agent/release-gate.ts",
    "release:agent:package": "${BUTLER_BUN:-bun} run --silent deploy/agent/package-agent.ts",
    "release:agent:smoke": "${BUTLER_BUN:-bun} run --silent deploy/agent/smoke.ts",
    "release:service:gate": "${BUTLER_BUN:-bun} run --silent release:agent:gate",
    "release:service:package": "${BUTLER_BUN:-bun} run --silent release:agent:package",
    "release:app:gate": "${BUTLER_BUN:-bun} run --silent deploy/app/release-gate.ts",
    "release:app:package": "${BUTLER_BUN:-bun} run --silent deploy/app/package-app.ts",
    "release:app:smoke": "${BUTLER_BUN:-bun} run --silent deploy/app/smoke.ts",
    "release:gate": "${BUTLER_BUN:-bun} run --silent release:agent:gate && ${BUTLER_BUN:-bun} run --silent release:app:gate",
    "check": "${BUTLER_BUN:-bun} run --silent tools/validation/validate.ts check:run",
    "check:verbose": "${BUTLER_BUN:-bun} run --silent tools/validation/validate.ts check:run --verbose",
    "check:run": "${BUTLER_BUN:-bun} run --silent lint && ${BUTLER_BUN:-bun} run --silent typecheck && ${BUTLER_BUN:-bun} run --silent lint:btcc-shape && ${BUTLER_BUN:-bun} run --silent test:unit:fast:run && bash tests/unit/managed-bun-runtime.test.sh && bash tests/unit/native-purge-gate.sh",
    "check:packaging": "${BUTLER_BUN:-bun} run --silent tools/validation/validate.ts check:packaging:run --timeout=1200",
    "check:packaging:verbose": "${BUTLER_BUN:-bun} run --silent tools/validation/validate.ts check:packaging:run --verbose --timeout=1200",
    "check:packaging:run": "${BUTLER_BUN:-bun} run --silent test:unit:packaging:run",
    "check:full": "${BUTLER_BUN:-bun} run --silent tools/validation/validate.ts check:full:run --timeout=1800",
    "check:full:verbose": "${BUTLER_BUN:-bun} run --silent tools/validation/validate.ts check:full:run --verbose --timeout=1800",
    "check:full:run": "${BUTLER_BUN:-bun} run --silent check:run && ${BUTLER_BUN:-bun} run --silent check:packaging:run",
    "prepare": "bun run --silent tools/configure-git-hooks.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@lancedb/lancedb": "^0.27.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@mozilla/readability": "^0.6.0",
    "apache-arrow": "^21.1.0",
    "chokidar": "^5.0.0",
    "grammy": "^1.21.0",
    "js-tiktoken": "^1.0.21",
    "jsdom": "^29.0.2",
    "telegramify-markdown": "^1.3.3",
    "tar": "^7.5.13",
    "turndown": "^7.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "@types/jsdom": "^28.0.1",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0"
  }
}
