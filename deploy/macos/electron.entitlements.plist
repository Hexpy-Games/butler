<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime exception for Butler.app and the Electron helper apps
     only: V8 maps JIT code with MAP_JIT, which allow-jit covers.
     allow-unsigned-executable-memory is left out on purpose. The native
     Agent, dylibs and the menu bar helper get none. All nested code is re-signed under one team, so
     library validation needs no exception. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
