{
  "name": "chat-long",
  "seed": [
    {
      "method": "PATCH",
      "path": "/settings",
      "body": {
        "language": "ko",
        "access_mode": "full_access",
        "reduce_motion": true
      }
    },
    {
      "method": "POST",
      "path": "/sessions",
      "body": {
        "kind": "chat",
        "title": "제품 회의 준비"
      }
    },
    {
      "method": "POST",
      "path": "/messages",
      "body": {
        "chat_id": "${session}",
        "text": "다음 주 제품 회의의 안건을 정리해 주세요. 접근성과 일정 공유가 중요합니다."
      },
      "wait": true
    },
    {
      "method": "POST",
      "path": "/messages",
      "body": {
        "chat_id": "${session}",
        "text": "## 회의 목표\n\n- 키보드 탐색 확인\n- 모바일 화면 검토\n- 출시 일정 합의"
      },
      "wait": true
    },
    {
      "method": "POST",
      "path": "/messages",
      "body": {
        "chat_id": "${session}",
        "text": "Please compare the two delivery options and explain the trade-offs."
      },
      "wait": true
    },
    {
      "method": "POST",
      "path": "/messages",
      "body": {
        "chat_id": "${session}",
        "text": "| Option | Date | Owner |\n| --- | --- | --- |\n| Pilot | Monday | Design |\n| Release | Friday | Engineering |"
      },
      "wait": true
    },
    {
      "method": "POST",
      "path": "/messages",
      "body": {
        "chat_id": "${session}",
        "text": "설정 예시도 함께 남겨 주세요.\n\n```json\n{ \"theme\": \"dark\", \"reduce_motion\": true }\n```"
      },
      "wait": true
    },
    {
      "method": "POST",
      "path": "/messages",
      "body": {
        "chat_id": "${session}",
        "text": "## 검토 결과\n\n한글과 English가 섞인 본문에서도 제목, 목록, 코드와 표의 흐름을 확인합니다.\n\n1. 회의 자료를 공유합니다.\n2. 담당자가 확인합니다.\n3. 금요일에 진행 상황을 정리합니다."
      },
      "wait": true
    }
  ],
  "open": {
    "chat": "제품 회의 준비"
  },
  "anchors": [
    {
      "anchor": "sidebar",
      "electron": "[data-test-class=\"app-sidebar\"]"
    },
    {
      "anchor": "chat-card",
      "electron": "[data-slot=\"adaptive-shell-split-chat\"]"
    },
    {
      "anchor": "composer",
      "electron": "[data-test-class=\"composer-card\"]"
    },
    {
      "anchor": "composer-field",
      "electron": "[contenteditable=\"true\"]"
    },
    {
      "anchor": "send-button",
      "electron": "[data-test-class=\"composer-send-button\"]"
    },
    {
      "anchor": "approval-card",
      "electron": "[data-test-class=\"composer-authority-decision\"]"
    },
    {
      "anchor": "question-card",
      "electron": "[data-slot=\"composer-question-panel\"]"
    },
    {
      "anchor": "titlebar",
      "electron": "[data-test-class=\"custom-titlebar\"]"
    },
    {
      "anchor": "sidebar-row-${session}",
      "electron": "[data-test-class=\"tree-row\"][aria-label=\"제품 회의 준비\"]"
    },
    {
      "anchor": "message-${message.0}",
      "electron": "[data-test-class~=\"message\"][data-index=\"0\"]"
    },
    {
      "anchor": "message-${message.1}",
      "electron": "[data-test-class~=\"message\"][data-index=\"1\"]"
    },
    {
      "anchor": "message-${message.2}",
      "electron": "[data-test-class~=\"message\"][data-index=\"2\"]"
    },
    {
      "anchor": "message-${message.3}",
      "electron": "[data-test-class~=\"message\"][data-index=\"3\"]"
    },
    {
      "anchor": "message-${message.4}",
      "electron": "[data-test-class~=\"message\"][data-index=\"4\"]"
    },
    {
      "anchor": "message-${message.5}",
      "electron": "[data-test-class~=\"message\"][data-index=\"5\"]"
    },
    {
      "anchor": "message-${message.6}",
      "electron": "[data-test-class~=\"message\"][data-index=\"6\"]"
    },
    {
      "anchor": "message-${message.7}",
      "electron": "[data-test-class~=\"message\"][data-index=\"7\"]"
    },
    {
      "anchor": "message-${message.8}",
      "electron": "[data-test-class~=\"message\"][data-index=\"8\"]"
    },
    {
      "anchor": "message-${message.9}",
      "electron": "[data-test-class~=\"message\"][data-index=\"9\"]"
    },
    {
      "anchor": "message-${message.10}",
      "electron": "[data-test-class~=\"message\"][data-index=\"10\"]"
    },
    {
      "anchor": "message-${message.11}",
      "electron": "[data-test-class~=\"message\"][data-index=\"11\"]"
    }
  ]
}
