{
  "name": "composer",
  "seed": [
    {
      "method": "PATCH",
      "path": "/settings",
      "body": {
        "language": "ko",
        "access_mode": "full_access",
        "reduce_motion": true
      }
    },
    {
      "method": "POST",
      "path": "/sessions",
      "body": {
        "kind": "chat",
        "title": "작성 중인 메시지"
      }
    },
    {
      "method": "PATCH",
      "path": "/sessions/${session}/controls",
      "body": {
        "access_mode": "ask_first",
        "reasoning_effort": "high"
      }
    },
    {
      "method": "POST",
      "path": "/messages",
      "body": {
        "chat_id": "${session}",
        "text": "회의 자료의 핵심만 먼저 알려 주세요."
      },
      "wait": true
    },
    {
      "method": "POST",
      "path": "/messages",
      "body": {
        "chat_id": "${session}",
        "text": "이어서 담당자별 일정도 정리해 주세요."
      },
      "wait": true
    }
  ],
  "open": {
    "chat": "작성 중인 메시지"
  },
  "anchors": [
    {
      "anchor": "sidebar",
      "electron": "[data-test-class=\"app-sidebar\"]"
    },
    {
      "anchor": "chat-card",
      "electron": "[data-slot=\"adaptive-shell-split-chat\"]"
    },
    {
      "anchor": "composer",
      "electron": "[data-test-class=\"composer-card\"]"
    },
    {
      "anchor": "composer-field",
      "electron": "[contenteditable=\"true\"]"
    },
    {
      "anchor": "send-button",
      "electron": "[data-test-class=\"composer-send-button\"]"
    },
    {
      "anchor": "titlebar",
      "electron": "[data-test-class=\"custom-titlebar\"]"
    },
    {
      "anchor": "sidebar-row-${session}",
      "electron": "[data-test-class=\"tree-row\"][aria-label=\"작성 중인 메시지\"]"
    },
    {
      "anchor": "message-${message.0}",
      "electron": "[data-test-class~=\"message\"][data-index=\"0\"]"
    },
    {
      "anchor": "message-${message.1}",
      "electron": "[data-test-class~=\"message\"][data-index=\"1\"]"
    },
    {
      "anchor": "message-${message.2}",
      "electron": "[data-test-class~=\"message\"][data-index=\"2\"]"
    },
    {
      "anchor": "message-${message.3}",
      "electron": "[data-test-class~=\"message\"][data-index=\"3\"]"
    }
  ]
}
