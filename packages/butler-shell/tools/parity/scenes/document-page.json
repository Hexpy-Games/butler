{
  "name": "document-page",
  "seed": [
    {
      "method": "PATCH",
      "path": "/settings",
      "body": {
        "language": "ko",
        "access_mode": "full_access",
        "reduce_motion": true
      }
    },
    {
      "method": "POST",
      "path": "/documents",
      "body": {
        "title": "회의 기록",
        "body": "# 회의 기록\n\n결정 사항을 정리했습니다.\n\n```blocks\n{\"v\":2,\"blocks\":[{\"type\":\"metrics\",\"id\":\"numbers\",\"title\":\"현황\",\"items\":[{\"label\":\"완료\",\"value\":12,\"unit\":\"건\"}]}]}\n```\n\n다음 단계는 모바일 검토입니다.\n",
        "author": "user"
      }
    }
  ],
  "open": {
    "new": true
  },
  "steps": [
    {
      "click": "library-entry"
    },
    {
      "expect": "library-page"
    },
    {
      "click": "library-document-card"
    },
    {
      "expect": "editable-document"
    },
    {
      "click": "document-versions-button"
    },
    {
      "expect": "document-versions"
    }
  ],
  "anchors": [
    {
      "anchor": "library-entry",
      "electron": "[data-test-class=\"library-entry\"]"
    },
    {
      "anchor": "library-page",
      "electron": "[data-test-class=\"library-region\"]"
    },
    {
      "anchor": "library-document-card",
      "electron": "[data-test-class=\"library-region\"] [aria-label=\"회의 기록\"]"
    },
    {
      "anchor": "editable-document",
      "electron": "[data-test-class=\"editable-document\"]"
    },
    {
      "anchor": "document-versions-button",
      "electron": "[data-test-class=\"editable-document\"] [aria-label=\"버전 기록\"]"
    },
    {
      "anchor": "document-versions",
      "electron": "[role=\"listbox\"][aria-label=\"버전 기록\"]"
    }
  ]
}
