{
  "name": "onboarding-ready",
  "seed": [
    {
      "method": "PATCH",
      "path": "/settings",
      "body": {
        "language": "ko",
        "access_mode": "full_access",
        "reduce_motion": true
      }
    }
  ],
  "reset": [
    {
      "method": "PATCH",
      "path": "/settings",
      "body": {
        "onboarding": {
          "consent_version": 2,
          "accepted_at": "2026-11-01T09:00:00.000Z",
          "completed_at": null
        }
      }
    }
  ],
  "open": {
    "setup": true
  },
  "steps": [
    {
      "click": "first-run-reply-next"
    },
    {
      "click": "first-run-agents-skip"
    },
    {
      "expect": "first-run-finish"
    }
  ],
  "anchors": [
    {
      "anchor": "first-run-setup",
      "electron": "[data-test-class=\"first-run-setup\"]"
    },
    {
      "anchor": "first-run-card",
      "electron": "[data-test-class=\"setup-wizard-stage\"] [data-test-class=\"setup-wizard-content\"]"
    },
    {
      "anchor": "first-run-reply-next",
      "electron": "[data-first-run-screen=\"connect\"] [data-slot=\"setup-step-footer\"] button:last-of-type:not(:disabled):not([aria-disabled=\"true\"])",
      "scroll": "first-run-setup"
    },
    {
      "anchor": "first-run-agents-skip",
      "electron": "[data-first-run-screen=\"import\"] [data-slot=\"setup-step-footer\"] button:first-of-type:not(:disabled):not([aria-disabled=\"true\"])",
      "scroll": "first-run-setup"
    },
    {
      "anchor": "first-run-finish",
      "electron": "[data-first-run-screen=\"ready\"] [data-slot=\"setup-step-footer\"] button:last-of-type:not(:disabled):not([aria-disabled=\"true\"])"
    }
  ]
}
