{
  "name": "dashboard-board",
  "seed": [
    {
      "method": "PATCH",
      "path": "/settings",
      "body": {
        "language": "ko",
        "access_mode": "full_access",
        "reduce_motion": true
      }
    },
    {
      "method": "POST",
      "path": "/projects",
      "body": {
        "source": "scratch",
        "display_name": "제품"
      },
      "save": {
        "project": "project.id"
      }
    },
    {
      "method": "POST",
      "path": "/projects/${project}/canon/plans",
      "body": {
        "title": "1차 출시",
        "description": ""
      },
      "save": {
        "plan": "id"
      }
    },
    {
      "method": "POST",
      "path": "/projects/${project}/canon/epics",
      "body": {
        "title": "요구사항 정리",
        "description": "",
        "plan_id": "${plan}",
        "assignee": "app-user"
      },
      "save": {
        "epic_a": "id"
      }
    },
    {
      "method": "POST",
      "path": "/projects/${project}/canon/epics",
      "body": {
        "title": "화면 설계",
        "description": "",
        "plan_id": "${plan}",
        "assignee": "app-user"
      },
      "save": {
        "epic_b": "id",
        "revision_b": "revision"
      }
    },
    {
      "method": "POST",
      "path": "/projects/${project}/canon/epics",
      "body": {
        "title": "출시 점검",
        "description": "",
        "plan_id": "${plan}"
      },
      "save": {
        "epic_c": "id"
      }
    },
    {
      "method": "PATCH",
      "path": "/canon/epics/${epic_b}",
      "body": {
        "expected_revision": "${revision_b}",
        "status": "in_progress"
      }
    }
  ],
  "open": {
    "new": true
  },
  "steps": [
    {
      "click": "sidebar-dashboard-${project}"
    },
    {
      "click": "dashboard-tab-work"
    },
    {
      "expect": "canon-board"
    },
    {
      "expect": "kanban-card-${epic_a}"
    }
  ],
  "anchors": [
    {
      "anchor": "sidebar-dashboard-${project}",
      "electron": "[data-tree-item=\"p:${project}\"] [aria-label$=\"프로젝트 대시보드\"]"
    },
    {
      "anchor": "dashboard-tab-work",
      "electron": "[role=\"tab\"][id$=\"-trigger-work\"]"
    },
    {
      "anchor": "canon-board",
      "electron": "[data-test-class=\"canon-board\"]"
    },
    {
      "anchor": "kanban-card-${epic_a}",
      "electron": "[data-kanban-item=\"${epic_a}\"]"
    },
    {
      "anchor": "kanban-card-${epic_b}",
      "electron": "[data-kanban-item=\"${epic_b}\"]"
    },
    {
      "anchor": "kanban-card-${epic_c}",
      "electron": "[data-kanban-item=\"${epic_c}\"]"
    }
  ]
}
