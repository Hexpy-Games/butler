{
  "name": "onboarding-welcome",
  "seed": [
    {
      "method": "PATCH",
      "path": "/settings",
      "body": {
        "language": "ko",
        "access_mode": "full_access",
        "reduce_motion": true
      }
    }
  ],
  "reset": [
    {
      "method": "PATCH",
      "path": "/settings",
      "body": {
        "onboarding": {
          "consent_version": null,
          "accepted_at": null,
          "completed_at": null
        }
      }
    }
  ],
  "open": {
    "setup": true
  },
  "steps": [
    {
      "expect": "first-run-start"
    }
  ],
  "anchors": [
    {
      "anchor": "first-run-setup",
      "electron": "[data-test-class=\"first-run-setup\"]"
    },
    {
      "anchor": "first-run-card",
      "electron": "[data-test-class=\"setup-wizard-stage\"] [data-test-class=\"setup-wizard-content\"]"
    },
    {
      "anchor": "first-run-start",
      "electron": "#first-run-start:not(:disabled):not([aria-disabled=\"true\"])"
    }
  ]
}
