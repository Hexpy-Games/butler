{
  "name": "dashboard-aside",
  "seed": [
    {
      "method": "PATCH",
      "path": "/settings",
      "body": {
        "language": "ko",
        "access_mode": "full_access",
        "reduce_motion": true
      }
    },
    {
      "method": "POST",
      "path": "/projects",
      "body": {
        "source": "scratch",
        "display_name": "제품"
      },
      "save": {
        "project": "project.id"
      }
    },
    {
      "method": "POST",
      "path": "/projects/${project}/canon/plans",
      "body": {
        "title": "1차 출시",
        "description": ""
      },
      "save": {
        "plan": "id"
      }
    },
    {
      "method": "POST",
      "path": "/projects/${project}/canon/epics",
      "body": {
        "title": "요구사항 정리",
        "description": "재현 방법과 기대 결과를 적습니다.",
        "plan_id": "${plan}",
        "assignee": "app-user"
      },
      "save": {
        "epic_a": "id"
      }
    }
  ],
  "open": {
    "new": true
  },
  "steps": [
    {
      "click": "sidebar-dashboard-${project}"
    },
    {
      "click": "dashboard-tab-work"
    },
    {
      "click": "kanban-card-${epic_a}"
    },
    {
      "expect": "canon-aside"
    },
    {
      "expect": "epic-detail"
    }
  ],
  "anchors": [
    {
      "anchor": "sidebar-dashboard-${project}",
      "electron": "[data-tree-item=\"p:${project}\"] [aria-label$=\"프로젝트 대시보드\"]"
    },
    {
      "anchor": "dashboard-tab-work",
      "electron": "[role=\"tab\"][id$=\"-trigger-work\"]"
    },
    {
      "anchor": "kanban-card-${epic_a}",
      "electron": "[data-kanban-item=\"${epic_a}\"]"
    },
    {
      "anchor": "canon-aside",
      "electron": "[data-slot=\"card\"]:has([data-test-class=\"canon-aside-close\"])"
    },
    {
      "anchor": "epic-detail",
      "electron": "[data-test-class=\"canon-epic-detail\"]"
    }
  ]
}
