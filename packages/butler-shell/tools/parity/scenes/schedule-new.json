{
  "name": "schedule-new",
  "seed": [
    {
      "method": "PATCH",
      "path": "/settings",
      "body": {
        "language": "ko",
        "access_mode": "full_access",
        "reduce_motion": true
      }
    },
    {
      "method": "POST",
      "path": "/sessions",
      "body": {
        "kind": "chat",
        "title": "주간 보고"
      }
    },
    {
      "method": "POST",
      "path": "/automations",
      "body": {
        "title": "아침 요약",
        "prompt_body": "어제 변경 사항을 요약해 주세요.",
        "target_session_id": "${session}",
        "interval_seconds": 3600,
        "access_mode": "read_only",
        "schedule": null,
        "schedule_type": "interval"
      }
    },
    {
      "method": "POST",
      "path": "/automations",
      "body": {
        "title": "한 번 점검",
        "prompt_body": "빌드 상태를 확인해 주세요.",
        "target_session_id": "${session}",
        "interval_seconds": 1800,
        "access_mode": "ask_except_reads",
        "schedule": null,
        "schedule_type": "once",
        "run_at": "2030-01-01T09:00:00.000Z"
      }
    }
  ],
  "open": {
    "new": true
  },
  "steps": [
    {
      "click": "sidebar-schedules"
    },
    {
      "expect": "automations-view"
    },
    {
      "click": "automation-new"
    },
    {
      "expect": "automation-detail"
    }
  ],
  "anchors": [
    {
      "anchor": "sidebar-schedules",
      "electron": "[data-test-class=\"app-sidebar\"] [aria-label=\"예약 작업\"]"
    },
    {
      "anchor": "automations-view",
      "electron": "[data-test-class=\"automations-view\"]"
    },
    {
      "anchor": "automation-new",
      "electron": "[data-test-class=\"automations-view\"] button"
    },
    {
      "anchor": "automation-detail",
      "electron": "[data-test-class=\"automation-detail-view\"]"
    },
    {
      "anchor": "automation-detail-titlebar",
      "electron": "[data-test-class=\"automation-detail-titlebar\"]"
    },
    {
      "anchor": "automation-title",
      "electron": "[data-test-class=\"automation-detail-view\"] input"
    },
    {
      "anchor": "automation-prompt",
      "electron": "[data-test-class=\"automation-detail-view\"] textarea"
    },
    {
      "anchor": "automation-model-field",
      "electron": "[data-test-class=\"automation-model-field\"]"
    },
    {
      "anchor": "automation-access-field",
      "electron": "[data-test-class=\"automation-access-field\"]"
    }
  ]
}
