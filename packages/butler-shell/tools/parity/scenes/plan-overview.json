{
  "name": "plan-overview",
  "seed": [
    {
      "method": "PATCH",
      "path": "/settings",
      "body": {
        "language": "ko",
        "access_mode": "full_access",
        "reduce_motion": true
      }
    },
    {
      "method": "POST",
      "path": "/projects",
      "body": {
        "source": "scratch",
        "display_name": "제품"
      },
      "save": {
        "project": "project.id"
      }
    },
    {
      "method": "POST",
      "path": "/projects/${project}/canon/plans",
      "body": {
        "title": "출시 준비",
        "description": "첫 공개 버전을 준비합니다.",
        "due_on": "2030-06-30"
      },
      "save": {
        "plan": "id"
      }
    },
    {
      "method": "POST",
      "path": "/projects/${project}/canon/epics",
      "body": {
        "title": "설치 안내 쓰기",
        "description": "처음 쓰는 사람을 위한 안내\n둘째 줄",
        "plan_id": "${plan}",
        "assignee": "app-user",
        "tags": []
      }
    },
    {
      "method": "POST",
      "path": "/projects/${project}/canon/epics",
      "body": {
        "title": "오류 보고 정리",
        "description": "",
        "plan_id": "${plan}",
        "assignee": null,
        "tags": []
      }
    },
    {
      "method": "POST",
      "path": "/projects/${project}/canon/epics",
      "body": {
        "title": "가격표 확정",
        "description": "공개 전에 정합니다.",
        "plan_id": "${plan}",
        "assignee": "app-user",
        "tags": []
      }
    }
  ],
  "open": {
    "new": true
  },
  "steps": [
    {
      "hover": "sidebar-canon-group-canon:${project}:${plan}"
    },
    {
      "click": "sidebar-canon-menu-canon:${project}:${plan}"
    },
    {
      "click": "canon-menu-canon:${project}:${plan}-item-0-0"
    },
    {
      "expect": "canon-plan-overview"
    }
  ],
  "anchors": [
    {
      "anchor": "sidebar-canon-group-canon:${project}:${plan}",
      "electron": "[data-test-class=\"app-sidebar\"] [data-test-class=\"canon-sidebar-group\"]:has([aria-label=\"출시 준비 메뉴\"])"
    },
    {
      "anchor": "sidebar-canon-menu-canon:${project}:${plan}",
      "electron": "[data-test-class=\"app-sidebar\"] [aria-label=\"출시 준비 메뉴\"]"
    },
    {
      "anchor": "canon-menu-canon:${project}:${plan}-item-0-0",
      "electron": "[role=\"menuitem\"]"
    },
    {
      "anchor": "canon-plan-overview",
      "electron": "[data-test-class=\"canon-plan-overview\"]"
    }
  ]
}
