{
  "name": "inspector",
  "seed": [
    {
      "method": "PATCH",
      "path": "/settings",
      "body": {
        "language": "ko",
        "access_mode": "full_access",
        "reduce_motion": true
      }
    },
    {
      "method": "POST",
      "path": "/sessions",
      "body": {
        "kind": "chat",
        "title": "회의 결과 정리"
      }
    },
    {
      "method": "POST",
      "path": "/messages",
      "body": {
        "chat_id": "${session}",
        "text": "회의 결과를 report.md 파일로 정리해서 전달해 주세요."
      },
      "wait": true
    }
  ],
  "stubToolCalls": [
    {
      "name": "write_file",
      "arguments": {
        "path": "report.md",
        "content": "# 회의 결과\n\n## 결정 사항\n\n- 키보드 탐색 확인\n- 출시 일정 합의\n\n## 다음 단계\n\n1. 모바일 화면 검토\n2. 접근성 점검\n",
        "create_parents": true
      }
    },
    {
      "name": "deliver_files",
      "arguments": {
        "files": [
          {
            "path": "report.md",
            "title": "회의 결과"
          }
        ]
      }
    }
  ],
  "ready": "artifacts",
  "steps": [
    {
      "click": "session-info-toggle"
    },
    {
      "expect": "inspector"
    }
  ],
  "open": {
    "chat": "회의 결과 정리"
  },
  "anchors": [
    {
      "anchor": "sidebar",
      "electron": "[data-test-class=\"app-sidebar\"]"
    },
    {
      "anchor": "chat-card",
      "electron": "[data-slot=\"adaptive-shell-split-chat\"]"
    },
    {
      "anchor": "composer",
      "electron": "[data-test-class=\"composer-card\"]"
    },
    {
      "anchor": "titlebar",
      "electron": "[data-test-class=\"custom-titlebar\"]"
    },
    {
      "anchor": "session-info-toggle",
      "electron": "[data-test-class=\"session-info-toggle\"]"
    },
    {
      "anchor": "inspector",
      "electron": "[data-slot=\"conversation-aside\"]"
    },
    {
      "anchor": "sidebar-row-${session}",
      "electron": "[data-test-class=\"tree-row\"][aria-label=\"회의 결과 정리\"]"
    },
    {
      "anchor": "message-${message.0}",
      "electron": "[data-test-class~=\"message\"][data-index=\"0\"]"
    }
  ]
}
