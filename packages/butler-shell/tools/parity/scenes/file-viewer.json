{
  "name": "file-viewer",
  "seed": [
    {
      "method": "PATCH",
      "path": "/settings",
      "body": {
        "language": "ko",
        "access_mode": "full_access",
        "reduce_motion": true
      }
    },
    {
      "method": "POST",
      "path": "/sessions",
      "body": {
        "kind": "chat",
        "title": "회의 결과 문서"
      }
    },
    {
      "method": "POST",
      "path": "/messages",
      "body": {
        "chat_id": "${session}",
        "text": "회의 결과를 report.md 파일로 정리해서 전달해 주세요."
      },
      "wait": true
    }
  ],
  "toolCalls": [
    {
      "name": "write_file",
      "arguments": {
        "path": "report.md",
        "content": "# 회의 결과\n\n## 결정 사항\n\n- 키보드 탐색 확인\n- 출시 일정 합의\n\n| 항목 | 담당 | 일정 |\n| --- | --- | --- |\n| 파일럿 | 디자인 | 월요일 |\n| 출시 | 엔지니어링 | 금요일 |\n\n## 다음 단계\n\n1. 모바일 화면 검토\n2. 접근성 점검\n",
        "create_parents": true
      }
    },
    {
      "name": "deliver_files",
      "arguments": {
        "files": [
          {
            "path": "report.md",
            "title": "회의 결과"
          }
        ]
      }
    }
  ],
  "ready": "artifacts",
  "steps": [
    {
      "click": "session-info-toggle"
    },
    {
      "click": "artifact-tile-0"
    },
    {
      "expect": "file-viewer"
    }
  ],
  "open": {
    "chat": "회의 결과 문서"
  },
  "anchors": [
    {
      "anchor": "sidebar",
      "electron": "[data-test-class=\"app-sidebar\"]"
    },
    {
      "anchor": "chat-card",
      "electron": "[data-slot=\"adaptive-shell-split-chat\"]"
    },
    {
      "anchor": "titlebar",
      "electron": "[data-test-class=\"custom-titlebar\"]"
    },
    {
      "anchor": "file-viewer",
      "electron": "[data-test-class=\"file-viewer\"]"
    },
    {
      "anchor": "file-viewer-header",
      "electron": "[data-test-class=\"file-viewer-header\"]"
    },
    {
      "anchor": "file-viewer-page",
      "electron": "[data-test-class=\"file-viewer-page\"]"
    },
    {
      "anchor": "sidebar-row-${session}",
      "electron": "[data-test-class=\"tree-row\"][aria-label=\"회의 결과 문서\"]"
    },
    {
      "anchor": "message-${message.0}",
      "electron": "[data-test-class~=\"message\"][data-index=\"0\"]"
    },
    {
      "anchor": "session-info-toggle",
      "electron": "[data-test-class=\"session-info-toggle\"]"
    },
    {
      "anchor": "artifact-tile-0",
      "electron": "[data-session-section=\"artifacts\"] [data-slot=\"document-tile\"]"
    }
  ]
}
