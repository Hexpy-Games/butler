{
  "name": "history",
  "seed": [
    {
      "method": "PATCH",
      "path": "/settings",
      "body": {
        "language": "ko",
        "access_mode": "full_access",
        "reduce_motion": true
      }
    },
    {
      "method": "POST",
      "path": "/sessions",
      "body": {
        "kind": "chat",
        "title": "이번 주 회의"
      }
    }
  ],
  "open": {
    "new": true
  },
  "steps": [
    {
      "click": "sidebar-settings"
    },
    {
      "click": "settings-nav-browser"
    },
    {
      "click": "browser-history-view"
    },
    {
      "expect": "history-page"
    }
  ],
  "anchors": [
    {
      "anchor": "sidebar-settings",
      "electron": "[data-test-class=\"app-sidebar\"] [aria-label=\"설정\"]"
    },
    {
      "anchor": "settings-nav-browser",
      "electron": "[data-test-class=\"settings-sidebar\"] [aria-label=\"브라우저\"]",
      "scroll": "settings-nav-scroll"
    },
    {
      "anchor": "browser-history-view",
      "electron": "[data-setting-id=\"browser-history\"] button:first-of-type"
    },
    {
      "anchor": "history-page",
      "electron": "[data-test-class=\"history-page\"]"
    }
  ]
}
