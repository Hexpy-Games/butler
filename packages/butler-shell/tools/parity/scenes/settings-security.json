{
  "name": "settings-security",
  "seed": [
    {
      "method": "PATCH",
      "path": "/settings",
      "body": {
        "language": "ko",
        "access_mode": "full_access",
        "reduce_motion": true
      }
    },
    {
      "method": "POST",
      "path": "/sessions",
      "body": {
        "kind": "chat",
        "title": "이번 주 회의"
      }
    }
  ],
  "open": {
    "new": true
  },
  "steps": [
    {
      "click": "sidebar-settings"
    },
    {
      "click": "settings-nav-security"
    },
    {
      "expect": "settings-page-security"
    }
