      "electron": "[data-test-class~=\"settings-view\"]"
    },
    {
      "anchor": "settings-nav-security",
      "electron": "[data-test-class=\"settings-sidebar\"] [aria-label=\"보안\"]",
      "scroll": "settings-nav-scroll"
    },
    {
      "anchor": "settings-page-security",
      "electron": "[data-test-class~=\"settings-view\"]:has([data-test-class=\"settings-sidebar\"] [aria-current=\"page\"][aria-label=\"보안\"]) [data-test-class=\"settings-detail-scroll\"]"
    }
  ]
