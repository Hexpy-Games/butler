{
  "name": "new-chat",
  "seed": [
    {
      "method": "PATCH",
      "path": "/settings",
      "body": {
        "language": "ko",
        "access_mode": "full_access",
        "reduce_motion": true
      }
    },
    {
      "method": "POST",
      "path": "/sessions",
      "body": {
        "kind": "chat",
        "title": "이번 주 회의"
      }
    }
  ],
  "open": {
    "new": true
  },
  "anchors": [
    {
      "anchor": "sidebar",
      "electron": "[data-test-class=\"app-sidebar\"]"
    },
    {
      "anchor": "chat-card",
      "electron": "[data-slot=\"adaptive-shell-split-chat\"]"
    },
    {
      "anchor": "composer",
      "electron": "[data-test-class=\"composer-card\"]"
    },
    {
      "anchor": "composer-field",
      "electron": "[contenteditable=\"true\"]"
    },
    {
      "anchor": "send-button",
      "electron": "[data-test-class=\"composer-send-button\"]"
    },
    {
      "anchor": "approval-card",
      "electron": "[data-test-class=\"composer-authority-decision\"]"
    },
    {
      "anchor": "question-card",
      "electron": "[data-slot=\"composer-question-panel\"]"
    },
    {
      "anchor": "titlebar",
      "electron": "[data-test-class=\"custom-titlebar\"]"
    }
  ]
}
