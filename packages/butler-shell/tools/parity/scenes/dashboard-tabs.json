{
  "name": "dashboard-tabs",
  "seed": [
    {
      "method": "PATCH",
      "path": "/settings",
      "body": {
        "language": "ko",
        "access_mode": "full_access",
        "reduce_motion": true
      }
    },
    {
      "method": "POST",
      "path": "/projects",
      "body": {
        "source": "scratch",
        "display_name": "제품"
      },
      "save": {
        "project": "project.id"
      }
    }
  ],
  "open": {
    "new": true
  },
  "steps": [
    {
      "click": "sidebar-dashboard-${project}"
    },
    {
      "click": "dashboard-tab-materials"
    },
    {
      "expect": "dashboard-materials"
    },
    {
      "click": "dashboard-tab-history"
    },
    {
      "expect": "dashboard-history"
    },
    {
      "click": "dashboard-tab-statistics"
    },
    {
      "expect": "dashboard-statistics"
    }
  ],
  "anchors": [
    {
      "anchor": "sidebar-dashboard-${project}",
      "electron": "[data-tree-item=\"p:${project}\"] [aria-label=\"프로젝트 대시보드\"]"
    },
    {
      "anchor": "dashboard-tab-materials",
      "electron": "[role=\"tab\"][id$=\"-trigger-materials\"]"
    },
    {
      "anchor": "dashboard-tab-history",
      "electron": "[role=\"tab\"][id$=\"-trigger-history\"]"
    },
    {
      "anchor": "dashboard-tab-statistics",
      "electron": "[role=\"tab\"][id$=\"-trigger-statistics\"]"
    },
    {
      "anchor": "dashboard-materials",
      "electron": "[role=\"tabpanel\"][id$=\"-content-materials\"]"
    },
    {
      "anchor": "dashboard-history",
      "electron": "[role=\"tabpanel\"][id$=\"-content-history\"]"
    },
    {
      "anchor": "dashboard-statistics",
      "electron": "[data-test-class=\"project-statistics\"]"
    }
  ]
}
