---
/** The manual's landing page for one locale: /help/ and /<locale>/help/. */
import { Typo } from "../ds/components/Typo";
import { BrandMark } from "../ds/web/BrandMark/BrandMark";
import pageStyles from "../ds/web/DocPage/DocPage.module.css";
import DocsLayout from "../ds/web/DocsLayout/DocsLayout.astro";
import { DocsHome } from "../ds/web/DocsHome/DocsHome";
import styles from "../ds/web/DocsHome/DocsHome.module.css";
import { alternates, loadNav } from "./docs";
import { docsRoot } from "./nav";
import type { Locale } from "./sections";
import { ui } from "./ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui(locale);
const nav = await loadNav(locale, "");
---
<DocsLayout
  alternates={await alternates(null)}
  description={copy.home.description}
  homeHref={docsRoot(import.meta.env.BASE_URL, locale)}
  locale={locale}
  nav={nav}
  title={copy.home.title}
>
  <article class={pageStyles.article}>
    <header class={styles.hero} data-mark-hover>
      <span class={styles.heroMark}><BrandMark client:load intro size="hero" /></span>
      <Typo.H1>{copy.home.title}</Typo.H1>
      <p class={pageStyles.lead}>{copy.home.description}</p>
    </header>
    <DocsHome plannedBadge={copy.planned.badge} plannedReason={copy.planned.reason} sections={nav} />
  </article>
</DocsLayout>
