---
/**
 * Static redirect (GitHub Pages has no server redirects): a script that keeps
 * the #anchor, a meta refresh without JavaScript, and a plain link.
 */
import { redirectScript } from "./redirects";

interface Props {
  to: string;
}

const { to } = Astro.props;
const canonical = Astro.site ? new URL(to, Astro.site).href : undefined;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <title>Butler 사용 설명서</title>
    <meta content="noindex" name="robots" />
    {canonical && <link href={canonical} rel="canonical" />}
    <script is:inline set:html={redirectScript(to)} />
    <meta content={`0;url=${to}`} http-equiv="refresh" />
  </head>
  <body>
    <a href={to}>Butler 사용 설명서로 이동</a>
  </body>
</html>
