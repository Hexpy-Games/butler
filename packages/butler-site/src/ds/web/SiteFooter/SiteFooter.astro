---
import type { Locale } from "../../../site/sections";
import { ui } from "../../../site/ui";
import styles from "./SiteFooter.module.css";

interface Props {
  version: string;
  repositoryUrl: string;
  designSystemHref: string;
  locale: Locale;
}

const { version, repositoryUrl, designSystemHref, locale } = Astro.props;
const copy = ui(locale).footer;
---
<footer class={styles.footer} data-pagefind-ignore>
  <span>Butler v{version} · {copy.status}</span>
  <ul class={styles.links}>
    <li><a class={styles.link} href={designSystemHref}>{copy.designSystem}</a></li>
    <li><a class={styles.link} href={`${repositoryUrl}/releases`} rel="noopener" target="_blank">{copy.releases}</a></li>
    <li><a class={styles.link} href={repositoryUrl} rel="noopener" target="_blank">GitHub</a></li>
  </ul>
</footer>
