---
import { switchHref } from "../../../site/nav";
import { LOCALES, type Locale } from "../../../site/sections";
import { ui } from "../../../site/ui";
import styles from "./LanguageSwitch.module.css";

interface Props {
  locale: Locale;
  /** This page in each locale; null when that translation is not published. */
  alternates: Partial<Record<Locale, string | null>>;
}

const { locale, alternates } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<nav class={styles.group} aria-label={ui(locale).language}>
  {LOCALES.map((code) => {
    const { languageCode, languageName } = ui(code);
    if (code === locale) {
      return <span aria-current="true" class:list={[styles.option, styles.current]} lang={code} title={languageName}>{languageCode}</span>;
    }
    // The same page in the other language; its landing page when there is no translation yet.
    return (
      <a
        aria-label={languageName}
        class={styles.option}
        data-language-switch={alternates[code] ? "page" : "home"}
        href={switchHref(alternates, base, code)}
        hreflang={code}
        lang={code}
        title={languageName}
      >{languageCode}</a>
    );
  })}
</nav>
