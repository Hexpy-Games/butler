---
import type { Locale } from "../../../site/sections";
import { ui } from "../../../site/ui";
import { Kbd } from "../../components/Kbd";
import { Search } from "../../components/Icons";
import styles from "./SearchDialog.module.css";

interface Props {
  /** Site base path; the Pagefind bundle lives at <base>pagefind/. */
  base: string;
  locale: Locale;
}

const { base, locale } = Astro.props;
const copy = ui(locale).search;
---
<dialog
  aria-label={copy.label}
  class={styles.dialog}
  data-base={base}
  data-copy-empty={copy.empty}
  data-copy-loading={copy.loading}
  data-copy-unavailable={copy.unavailable}
  data-search-dialog
>
  <div class={styles.field}>
    <Search />
    <input
      aria-controls="search-results"
      aria-label={copy.label}
      autocomplete="off"
      class={styles.input}
      data-search-input
      placeholder={copy.label}
      spellcheck="false"
      type="search"
    />
  </div>
  <div class={styles.results} data-scroll-fade="y" id="search-results">
    <p aria-live="polite" class={styles.status} data-search-status></p>
    <ul class={styles.list} data-search-list></ul>
  </div>
  <div class={styles.footer} aria-hidden="true">
    <span class={styles.hint}><Kbd keys={["↑", "↓"]} size="sm" /> {copy.move}</span>
    <span class={styles.hint}><Kbd keys={["↵"]} size="sm" /> {copy.open}</span>
    <span class={styles.hint}><Kbd keys={["esc"]} size="sm" /> {copy.close}</span>
  </div>
  <template data-search-item>
    <li>
      <a class={styles.result}>
        <span class={styles.resultTitle}></span>
        <span class={styles.resultExcerpt}></span>
      </a>
    </li>
  </template>
</dialog>
