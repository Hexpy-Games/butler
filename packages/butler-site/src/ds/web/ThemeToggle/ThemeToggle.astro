---
import type { Locale } from "../../../site/sections";
import { ui } from "../../../site/ui";
import { Computer, Moon, Sun } from "../../components/Icons";
import styles from "./ThemeToggle.module.css";

interface Props {
  locale: Locale;
}

const copy = ui(Astro.props.locale).theme;
const options = [
  { value: "system", label: copy.system, Icon: Computer },
  { value: "light", label: copy.light, Icon: Sun },
  { value: "dark", label: copy.dark, Icon: Moon },
] as const;
---
<div class={styles.group} role="group" aria-label={copy.label}>
  {options.map(({ value, label, Icon }) => (
    <button
      aria-label={label}
      aria-pressed={value === "system" ? "true" : "false"}
      class={styles.option}
      data-theme-choice={value}
      title={label}
      type="button"
    >
      <Icon size="sm" />
    </button>
  ))}
</div>
