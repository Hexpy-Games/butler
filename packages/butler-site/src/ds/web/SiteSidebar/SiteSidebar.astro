---
import type { NavSectionItem } from "../../../site/nav";
import type { Locale } from "../../../site/sections";
import { ui } from "../../../site/ui";
import { Button } from "../../components/Button";
import { Close } from "../../components/Icons";
import Brand from "../Brand/Brand.astro";
import LanguageSwitch from "../LanguageSwitch/LanguageSwitch.astro";
import { SidebarNav } from "../SidebarNav/SidebarNav";
import ThemeToggle from "../ThemeToggle/ThemeToggle.astro";
import styles from "./SiteSidebar.module.css";

interface Props {
  nav: NavSectionItem[];
  homeHref: string;
  locale: Locale;
  alternates: Partial<Record<Locale, string | null>>;
}

const { nav, homeHref, locale, alternates } = Astro.props;
const copy = ui(locale);
---
<aside aria-label={copy.sidebar} class={styles.sidebar} data-drawer data-pagefind-ignore id="site-nav">
  <div class={styles.brandRow}>
    <Brand href={homeHref} product={copy.product} />
    <span class={styles.close}>
      <Button aria-label={copy.closeMenu} data-drawer-close size="icon" variant="ghost"><Close /></Button>
    </span>
  </div>
  <nav aria-label={copy.docs} class={styles.nav} data-scroll-fade="y">
    <SidebarNav plannedBadge={copy.planned.badge} plannedReason={copy.planned.reason} sections={nav} />
  </nav>
  <div class={styles.controls}>
    <LanguageSwitch alternates={alternates} locale={locale} />
    <ThemeToggle locale={locale} />
  </div>
</aside>
<div aria-hidden="true" class={styles.scrim} data-drawer-close data-drawer-scrim></div>
