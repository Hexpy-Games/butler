---
// The site-wide 404.html (GitHub Pages serves it for every missing path).
// /ds/<path> links forward to the DS Viewer's ?page= route before paint;
// everything else shows the manual's not-found page.
import { Typo } from "../ds/components/Typo";
import pageStyles from "../ds/web/DocPage/DocPage.module.css";
import DocsLayout from "../ds/web/DocsLayout/DocsLayout.astro";
import { alternates, loadNav } from "../site/docs";
import { docsRoot } from "../site/nav";

const title = "페이지를 찾을 수 없습니다";
const description = "주소가 바뀌었거나 없는 페이지입니다.";
const homeHref = docsRoot(import.meta.env.BASE_URL, "ko");
---
<DocsLayout
  alternates={await alternates(null)}
  description={description}
  homeHref={homeHref}
  locale="ko"
  nav={await loadNav("ko", "")}
  noindex
  title={title}
>
  <article class={pageStyles.article}>
    <header class={pageStyles.header}>
      <Typo.H1>{title}</Typo.H1>
      <p class={pageStyles.lead}>{description} <a href={homeHref}>사용 설명서 처음으로</a></p>
    </header>
  </article>
</DocsLayout>
