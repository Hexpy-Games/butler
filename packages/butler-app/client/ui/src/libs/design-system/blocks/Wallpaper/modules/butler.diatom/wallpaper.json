      "type": "enum",
      "label": {
        "en": "Illumination",
        "ko": "조명 방식"
      },
      "options": [
        {
          "value": "brightfield",
          "label": {
            "en": "Brightfield",
            "ko": "명시야"
          }
        },
        {
          "value": "darkfield",
          "label": {
            "en": "Darkfield",
            "ko": "암시야"
          }
