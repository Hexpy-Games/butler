{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.hexpy.games/schemas/native-agent-install.v1.json",
  "$comment": "Install platforms use Node process.platform/process.arch names: darwin/arm64, linux/x64 and linux/arm64. The Agent accepts only its own host's platform; Windows (win32) installations are not supported yet.",
  "title": "Butler standalone native Agent installation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "platform",
    "architecture",
    "binary",
    "resources",
    "launcher",
    "binarySha256",
    "resourcesSha256"
  ],
  "properties": {
    "schema": { "const": "butler.native-agent-install.v1" },
    "version": { "type": "string", "minLength": 1 },
    "appVersion": { "type": ["string", "null"] },
    "platform": { "enum": ["darwin", "linux"] },
    "architecture": { "enum": ["arm64", "x64"] },
    "binary": { "const": "butler-agent" },
    "resources": { "const": "resources" },
    "launcher": { "const": "butler" },
    "binarySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "resourcesSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "oneOf": [
    { "properties": { "platform": { "const": "darwin" }, "architecture": { "const": "arm64" } } },
    { "properties": { "platform": { "const": "linux" }, "architecture": { "enum": ["x64", "arm64"] } } }
  ]
}
