@echo off
powershell.exe -NoProfile -Command "[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false); if ($env:HOOK_FILE) { [Console]::Write([IO.File]::ReadAllText($env:HOOK_FILE)) } else { [Console]::Write($env:HOOK_TEXT) }; if ($env:HOOK_FAIL_ONCE) { if (Test-Path -LiteralPath $env:HOOK_FAIL_ONCE) { exit 0 }; New-Item -ItemType File -Path $env:HOOK_FAIL_ONCE | Out-Null }; exit [int]$env:HOOK_EXIT"
