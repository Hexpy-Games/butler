{
  "expo": {
    "name": "Butler",
    "slug": "butler",
    "scheme": "butler",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.hexpy.butler.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Butler connects to Butler on your computer over your local network.",
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true }
      }
    },
    "android": { "package": "com.hexpy.butler.mobile" },
    "locales": { "ko": "./locales/ko.json" },
    "plugins": [
      "expo-router",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }],
      ["expo-font", { "fonts": [
        "./node_modules/pretendard/dist/public/static/Pretendard-Regular.otf",
        "./node_modules/pretendard/dist/public/static/Pretendard-Medium.otf",
        "./node_modules/pretendard/dist/public/static/Pretendard-SemiBold.otf"
      ] }],
      ["expo-camera", {
        "cameraPermission": "Butler uses the camera to scan the pairing QR code shown on your computer.",
        "microphonePermission": false,
        "recordAudioAndroid": false
      }]
    ]
  }
}
